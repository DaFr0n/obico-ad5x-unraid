listening-port=3478
listening-ip=YOUR_UNRAID_IP
relay-ip=YOUR_UNRAID_IP
external-ip=YOUR_PUBLIC_IPV4/YOUR_UNRAID_IP

realm=obico.local
server-name=obico-turn

fingerprint
use-auth-secret
static-auth-secret=YOUR_64_CHARACTER_TURN_SECRET

min-port=49160
max-port=49200

# Keep verbose disabled: it can create very large daily logs under /var/tmp.
no-cli
no-tls
no-dtls
stale-nonce=600
